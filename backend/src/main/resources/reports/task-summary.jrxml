<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task volume by category and outcome (requirement #14).

  Filled from a JRBeanCollectionDataSource of TaskSummaryRow. Grouped by category so the
  report reads as "what work do we get, and how does it end".
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="task-summary" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              whenNoDataType="NoDataSection">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="RANGE_LABEL" class="java.lang.String"/>

    <field name="category" class="java.lang.String"/>
    <field name="statusName" class="java.lang.String"/>
    <field name="taskCount" class="java.lang.Long"/>
    <field name="totalBudgetOrZero" class="java.math.BigDecimal"/>

    <variable name="totalTasks" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{taskCount}]]></variableExpression>
    </variable>
    <variable name="totalValue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalBudgetOrZero}]]></variableExpression>
    </variable>

    <group name="categoryGroup">
        <groupExpression><![CDATA[$F{category}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <textField>
                    <reportElement x="0" y="4" width="515" height="14"/>
                    <textElement><font size="10" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{category}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="70">
            <!--
              Resolved off the classpath, the same way ReportService loads this template.
              PNG rather than SVG on purpose: SVG rendering needs Batik, which is not
              guaranteed on the JasperReports 6.21 classpath, and a missing renderer fails
              at fill time rather than at compile time.
              The text fields below stop at 455 to leave this the right-hand gutter.
            -->
            <image scaleImage="RetainShape" hAlign="Right" vAlign="Middle">
                <reportElement x="467" y="0" width="48" height="48"/>
                <imageExpression><![CDATA["reports/logo.png"]]></imageExpression>
            </image>
            <textField>
                <reportElement x="0" y="0" width="455" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="26" width="455" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Sewa Sathi  ·  " + $P{RANGE_LABEL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="42" width="455" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="62" width="515" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="4" width="240" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Outcome]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="4" width="120" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Tasks]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="4" width="155" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total budget (NPR)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="20" width="515" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="14" y="2" width="226" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{statusName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="2" width="120" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{taskCount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="360" y="2" width="155" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{totalBudgetOrZero}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="34">
            <line>
                <reportElement x="0" y="2" width="515" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="8" width="240" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[All categories]]></text>
            </staticText>
            <textField>
                <reportElement x="240" y="8" width="120" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalTasks}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="360" y="8" width="155" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalValue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="12" width="515" height="16"/>
                <textElement textAlignment="Center"><font size="10" isItalic="true"/></textElement>
                <text><![CDATA[No tasks were posted in this period.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
