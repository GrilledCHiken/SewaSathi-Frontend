<?xml version="1.0" encoding="UTF-8"?>
<!--
  Revenue by month and payment gateway (requirement #14).

  Filled from a JRBeanCollectionDataSource of RevenueReportRow, so every $F{...} below is a
  getter on that bean. No query is declared in the template on purpose: the data comes from
  the repository layer, which keeps the SQL under the same review and testing as the rest of
  the application.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="revenue" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40"
              whenNoDataType="NoDataSection">

    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="GENERATED_AT" class="java.lang.String"/>
    <parameter name="RANGE_LABEL" class="java.lang.String"/>

    <field name="period" class="java.lang.String"/>
    <field name="providerName" class="java.lang.String"/>
    <field name="transactionCount" class="java.lang.Long"/>
    <field name="collectedAmount" class="java.math.BigDecimal"/>
    <field name="taskValue" class="java.math.BigDecimal"/>

    <variable name="totalCollected" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{collectedAmount}]]></variableExpression>
    </variable>
    <variable name="totalTaskValue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{taskValue}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <!--
              Resolved off the classpath, the same way ReportService loads this template.
              PNG rather than SVG on purpose: SVG rendering needs Batik, which is not
              guaranteed on the JasperReports 6.21 classpath, and a missing renderer fails
              at fill time rather than at compile time.
              The text fields below stop at 455 to leave this the right-hand gutter.
            -->
            <image scaleImage="RetainShape" hAlign="Right" vAlign="Middle">
                <reportElement x="467" y="0" width="48" height="48"/>
                <imageExpression><![CDATA["reports/logo.png"]]></imageExpression>
            </image>
            <textField>
                <reportElement x="0" y="0" width="455" height="24"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="26" width="455" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Sewa Sathi  ·  " + $P{RANGE_LABEL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="42" width="455" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Generated " + $P{GENERATED_AT}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="62" width="515" height="1"/>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement x="0" y="4" width="150" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Month]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="4" width="90" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Gateway]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="4" width="80" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Payments]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="4" width="95" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Collected (NPR)]]></text>
            </staticText>
            <staticText>
                <reportElement x="415" y="4" width="100" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Task value (NPR)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="20" width="515" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="2" width="150" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{period}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="2" width="90" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{providerName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="2" width="80" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionCount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="320" y="2" width="95" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{collectedAmount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="415" y="2" width="100" height="14"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{taskValue}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="34">
            <line>
                <reportElement x="0" y="2" width="515" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="8" width="240" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="320" y="8" width="95" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalCollected}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="415" y="8" width="100" height="14"/>
                <textElement textAlignment="Right"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalTaskValue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="12" width="515" height="16"/>
                <textElement textAlignment="Center"><font size="10" isItalic="true"/></textElement>
                <text><![CDATA[No completed payments fell in this period.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
