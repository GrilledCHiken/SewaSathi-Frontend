# Copy this file to application.properties (which is gitignored) and fill in the
# secrets. Profile-specific settings live in application-{dev,prod}.properties,
# which are tracked in git and deliberately contain no secrets.
spring.application.name=sewasathi-api

spring.profiles.active=dev

spring.datasource.url=jdbc:mysql://127.0.0.1:3306/sewasathi?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=changeme
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

server.port=8080

# --- Session management (requirement #2) ---
# Governs the server-rendered admin console, the only session-backed surface; the REST
# API stays stateless and is governed by the JWT settings further down. An idle session
# past this window is invalidated and the browser is sent to /admin/login?expired.
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
# Keep false for local HTTP development; the prod profile sets it to true.
server.servlet.session.cookie.secure=false
server.servlet.session.cookie.name=SEWASATHI_SESSION
# Boot's whitelabel page is replaced by templates/error/*.html (requirement #8).
server.error.whitelabel.enabled=false

# --- Admin bootstrap ---
# Creates the first ADMIN account at startup when no admin exists, so a fresh clone can
# sign in at http://localhost:8080/admin. Change the password, and note that the prod
# profile disables this entirely.
app.admin.bootstrap.enabled=true
app.admin.bootstrap.email=admin@sewasathi.com
app.admin.bootstrap.password=Admin@123
app.admin.bootstrap.full-name=Site Administrator
app.admin.bootstrap.phone=9800000000

# Support details published by GET /api/public/contact-info and shown on the Contact page.
# Optional - ContactProperties falls back to these same values when the keys are absent.
app.contact.support-email=support@sewasathi.com
app.contact.phone=+977 1-444-5555
app.contact.phone-href=+97714445555
app.contact.address=Kathmandu, Nepal
app.contact.hours=Mon-Fri, 9 AM - 6 PM NPT
app.contact.careers-email=careers@sewasathi.com

# Directory for rotated log files (see logback-spring.xml).
app.log-dir=logs

# Browser origins allowed to call this API.
app.cors.allowed-origins=http://localhost:5173,http://localhost:5174

# Spring Boot Actuator. /actuator/health and /actuator/info are public; every other
# endpoint requires an ADMIN token.
management.endpoints.web.exposure.include=health,info,metrics,loggers
management.endpoint.health.show-details=when-authorized
management.endpoint.health.roles=ADMIN
management.info.env.enabled=true

# Generate your own secret, e.g.: openssl rand -base64 64
jwt.secret=REPLACE_WITH_A_LONG_RANDOM_BASE64_SECRET
# Access token: 15 minutes. A JWT cannot be revoked, so how soon it expires is the only
# real limit on a stolen one. The refresh token below is what keeps a user signed in,
# and unlike the JWT it lives in the database and can be revoked (requirement #2).
jwt.expiration-ms=900000
# Refresh token: 7 days. This is the hard ceiling on a session; rotating does not extend it.
jwt.refresh-expiration-ms=604800000
# Idle timeout: 30 minutes with no refresh and the session is over.
app.session.idle-timeout-ms=1800000

app.upload-dir=uploads
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

app.frontend-url=http://localhost:5173

# Sign-in is email + password only: no verification email, no social providers, and the
# application sends no mail at all. Nothing to configure here.

# eSewa ePay v2. These are eSewa's public UAT sandbox values (demo only, no real
# money). Replace all four with your merchant credentials for production.
# Sandbox secret key and test login credentials: see "Testing eSewa payments" in ../../../README.md
app.esewa.form-url=https://rc-epay.esewa.com.np/api/epay/main/v2/form
app.esewa.status-url=https://rc.esewa.com.np/api/epay/transaction/status/
app.esewa.merchant-code=EPAYTEST
app.esewa.secret-key=REPLACE_WITH_YOUR_ESEWA_SECRET_KEY
# Share of the task budget collected up front to confirm a booking.
app.esewa.advance-rate=0.10

# Khalti ePayment (KPG-2). These are the dev sandbox endpoints, and the key is
# Khalti's published sandbox credential (demo only, no real money) — the same deal
# as eSewa's EPAYTEST above. Set KHALTI_SECRET_KEY to use your own key from
# https://test-admin.khalti.com. Swap both URLs for https://khalti.com/api/v2/...
# in production; the prod profile already does.
app.khalti.initiate-url=https://dev.khalti.com/api/v2/epayment/initiate/
app.khalti.lookup-url=https://dev.khalti.com/api/v2/epayment/lookup/
app.khalti.secret-key=${KHALTI_SECRET_KEY:live_secret_key_68791341fdd94846a146f0457ff7b455}
