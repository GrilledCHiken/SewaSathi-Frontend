VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth client ID for "Sign in with Google". Must match app.google.client-id on the
# backend, which checks it as the token audience, and this app's origin must be listed under
# "Authorized JavaScript origins" in the Google Cloud Console. Leave it unset to run without
# Google sign-in: the button then renders nothing and the forms fall back to password-only.
VITE_GOOGLE_CLIENT_ID=
